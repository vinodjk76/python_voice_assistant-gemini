# Gemini API: create a key in Google AI Studio. Keep it private.
GEMINI_API_KEY=replace_with_your_gemini_api_key
GEMINI_MODEL=gemini-3.8-flash

# Wake phrase; keep this phrase easy to recognize.
WAKE_WORD=hey assistant

# Optional Home Assistant integration. Leave blank to disable.
HOME_ASSISTANT_URL=http://homeassistant.local:8123
HOME_ASSISTANT_TOKEN=
HOME_ASSISTANT_LIGHT_ENTITY=light.living_room
